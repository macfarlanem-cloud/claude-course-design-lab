# Copy this file to .env and paste your key after the equals sign.
# Get a key at https://console.anthropic.com (API Keys). Never share it or commit it.
ANTHROPIC_API_KEY=

# Only needed for the optional Step 5 (publish to Canvas).
# Base URL of your Canvas, a token from Account > Settings > New Access Token,
# and the course number from the course URL (/courses/123456).
CANVAS_BASE_URL=
CANVAS_TOKEN=
CANVAS_COURSE_ID=
